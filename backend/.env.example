# .env.example — Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env al repositorio

# ── API Keys externas ──────────────────────────────────
# FRED API: https://fred.stlouisfed.org/docs/api/
FRED_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ── Base de datos ──────────────────────────────────────
# SQLite local (desarrollo)
DATABASE_URL=sqlite:///./riesgo.db

# PostgreSQL (producción — opcional)
# DATABASE_URL=postgresql://user:password@host:5432/riesgo_db

# ── Parámetros del proyecto ────────────────────────────
# Tasa libre de riesgo por defecto (se sobreescribe con FRED en runtime)
TASA_LIBRE_RIESGO=0.0525

# Nivel de confianza VaR por defecto
VAR_CONFIANZA=0.95
